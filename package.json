{
  "name": "ambi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:fonts": "node scripts/font-catalog-generator.mjs",
    "dev": "vite",
    "build": "npm run generate:fonts && biome check && tsc && vite build",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome check --write",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/three": "^0.185",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "manifold-3d": "^3.4.1",
    "three": "^0.185.0"
  }
}
